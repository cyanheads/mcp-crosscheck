{
  "name": "mcp-crosscheck",
  "version": "0.1.0",
  "description": "Run real MCP clients against your server and diff their rendered tool surface against tools/list. Deterministic — no LLM calls.",
  "type": "module",
  "bin": {
    "mcp-crosscheck": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist/", "CHANGELOG.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/mcp-crosscheck.git"
  },
  "bugs": {
    "url": "https://github.com/cyanheads/mcp-crosscheck/issues"
  },
  "homepage": "https://github.com/cyanheads/mcp-crosscheck#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs finalize",
    "clean": "node scripts/build.mjs clean",
    "rebuild": "bun run clean && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write .",
    "test": "bun test",
    "fixture-server": "bun tests/fixture-server/server.ts",
    "list-skills": "bun run scripts/list-skills.ts",
    "devcheck": "bun run scripts/devcheck.ts",
    "prepublishOnly": "bun run rebuild"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@types/bun": "^1.4.2",
    "@types/node": "26.6.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "testing",
    "compatibility",
    "harness",
    "json-schema",
    "openapi",
    "mcpo",
    "mcp-inspector",
    "codex",
    "claude-code",
    "cli",
    "developer-tools"
  ],
  "author": "Casey Hand <casey@caseyjhand.com> (https://caseyjhand.com)",
  "license": "Apache-2.0",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cyanheads"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://www.buymeacoffee.com/cyanheads"
    }
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
